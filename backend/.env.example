# Backend Server Port
PORT=5001

# MongoDB Database URI (e.g. mongodb://localhost:27017/polyscan-ai or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/polyscan-ai

# Gemini Vision API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage Configuration (Optional for Cloudinary storage, local storage fallback used if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Auth Secret
JWT_SECRET=polyscan_ai_super_secret_jwt_key_2026

# Frontend Client URL
CLIENT_URL=http://localhost:5173
